{
  "name": "tauri-universal-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @app/docs dev",
    "dev:web": "pnpm --filter @app/docs dev:web",
    "build": "pnpm --filter @app/docs build",
    "build:web": "pnpm --filter @app/docs build:web",
    "preview": "pnpm --filter @app/docs preview",
    "rename-project": "tsx --tsconfig scripts/tsconfig.json scripts/renameProject.ts",
    "scaffold": "tsx packages/cli/src/index.ts",
    "agent": "tsx packages/cli/src/index.ts agent",
    "change:scope": "node .agents/scripts/change-scope.mjs",
    "workflow:check": "node .agents/scripts/workflow-check.mjs",
    "docs:check": "node .agents/scripts/doc-check.mjs",
    "mcp:test": "tsx packages/mcp/test/integration.ts",
    "agent:docs": "pnpm --filter @app/docs exec tsx scripts/generate-llm.ts",
    "agent:docs:check": "pnpm --filter @app/docs exec tsx scripts/generate-llm.ts --check",
    "agent:test": "tsx packages/cli/test/agent.integration.ts",
    "test": "pnpm foundation:typecheck && pnpm test:typecheck && pnpm foundation:test && pnpm test:unit && pnpm agent catalog-check && pnpm agent:test && pnpm mcp:test && pnpm source:test && pnpm source:build",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.vitest.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dev:native": "pnpm --filter @app/native-playground dev",
    "start:bare": "pnpm --filter uniwind-bare start",
    "foundation:typecheck": "tsc -p packages/agent-workflow/tsconfig.json",
    "foundation:test": "tsx --test packages/agent-workflow/test/foundation.test.ts packages/agent-workflow/test/review-regressions.test.mjs packages/mcp/test/foundation.integration.ts",
    "source": "node packages/cli/source/cli.mjs",
    "source:build": "node scripts/build-source-registry.mjs",
    "source:test": "node --test packages/cli/test/source.test.mjs packages/cli/test/source-regressions.test.mjs",
    "source:smoke": "node scripts/check-source-distribution.mjs",
    "source:compile": "node scripts/check-source-compilation.mjs",
    "source:pack": "npm pack ./dist/universal-cli --ignore-scripts --pack-destination dist",
    "nd": "node packages/nd-workflow/bin/nd.mjs",
    "nd:pack": "node packages/nd-workflow/bin/nd-package.mjs",
    "nd:doctor": "node packages/nd-workflow/bin/nd.mjs doctor .",
    "nd:check": "node packages/nd-workflow/bin/nd.mjs check .",
    "nd:tokens": "node packages/nd-workflow/bin/nd.mjs tokens ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react-dom": "19.2.6",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "playwright-core": "^1.62.1",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "5.8.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.6",
      "@babel/runtime": ">=7.26.10"
    }
  }
}
