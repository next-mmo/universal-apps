{
  "$schema": "./packages/cli/scaffold.config.schema.json",
  "targets": {
    "ui": {
      "componentDir": "packages/ui/src/components/ui",
      "templateDir": "packages/cli/templates/ui",
      "baseTemplate": "_base.tsx",
      "package": "@package/ui",
      "docsDir": "apps/docs/content/docs/components",
      "docsMeta": "apps/docs/content/docs/components/meta.json",
      "importRewrites": {
        "@/lib/cn": "../../lib/cn",
        "@/lib/utils": "../../lib/cn",
        "@/components/ui/": "./"
      }
    },
    "native": {
      "componentDir": "packages/ui-native/src/components/ui",
      "templateDir": "packages/cli/templates/native",
      "baseTemplate": "_base.tsx",
      "package": "@package/ui-native",
      "docsDir": "apps/docs/content/docs/platforms",
      "docsMeta": "apps/docs/content/docs/platforms/meta.json",
      "importRewrites": {
        "@/lib/cn": "@package/ui/cn",
        "@/components/ui/": "./"
      }
    }
  }
}
